{
  "name": "frontend-api-core",
  "version": "0.1.4",
  "sideEffects": false,
  "description": "Frontend API SDK core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wovka27/frontend-api-core.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "media"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run type-check && tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --test scripts/changelog-from-commits.test.mjs",
    "ci": "npm test && npm run lint && npm run build",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "~5.5.4"
  },
  "dependencies": {
    "axios": "^1.19.0"
  }
}
